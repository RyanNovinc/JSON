{
  "expo": {
    "name": "JSON.fit",
    "slug": "json",
    "version": "1.0.24",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "scheme": "json-app",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "splash": {
        "backgroundColor": "#000000"
      },
      "bundleIdentifier": "com.RyanNovinc.JSON",
      "buildNumber": "137",
      "associatedDomains": [
        "applinks:json.fit"
      ],
      "entitlements": {
        "aps-environment": "development",
        "com.apple.developer.associated-domains": [
          "applinks:json.fit"
        ]
      },
      "infoPlist": {
        "CFBundleDisplayName": "JSON.fit",
        "CFBundleName": "JSON.fit",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": false,
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "JSON.fit Program",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "fit.json.program"
            ]
          },
          {
            "CFBundleTypeName": "JSON Document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.json"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "fit.json.program",
            "UTTypeDescription": "JSON.fit Program",
            "UTTypeConformsTo": [
              "public.json"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "jsonfit"
              ],
              "public.mime-type": [
                "application/vnd.jsonfit+json"
              ]
            }
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-android-foreground.png",
        "monochromeImage": "./assets/icon-android-monochrome.png",
        "backgroundColor": "#22d3ee"
      },
      "package": "com.RyanNovinc.JSON",
      "versionCode": 100,
      "edgeToEdgeEnabled": true,
      "compileSdkVersion": 36,
      "targetSdkVersion": 36,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "json.fit",
              "pathPrefix": "/p/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/json"
            },
            {
              "scheme": "file",
              "mimeType": "application/json"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "836fbcc1-7997-4d00-b9eb-5d259570a9a7"
      }
    },
    "owner": "ryan_novinc",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-live-activity",
      "expo-asset",
      "expo-notifications",
      "./plugins/withAdiRegistration",
      "react-native-edge-to-edge",
      "expo-font"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/836fbcc1-7997-4d00-b9eb-5d259570a9a7"
    }
  }
}
