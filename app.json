{
  "expo": {
    "name": "JSON.fit",
    "slug": "json",
    "version": "1.0.22",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "scheme": "json-app",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.RyanNovinc.JSON",
      "buildNumber": "119",
      "associatedDomains": [
        "applinks:json.fit"
      ],
      "entitlements": {
        "aps-environment": "development",
        "com.apple.developer.associated-domains": ["applinks:json.fit"]
      },
      "infoPlist": {
        "CFBundleDisplayName": "JSON.fit",
        "CFBundleName": "JSON.fit",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0f0f0f"
      },
      "package": "com.RyanNovinc.JSON",
      "versionCode": 95,
      "edgeToEdgeEnabled": true,
      "compileSdkVersion": 36,
      "targetSdkVersion": 36,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "json.fit",
              "pathPrefix": "/p/program/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "836fbcc1-7997-4d00-b9eb-5d259570a9a7"
      }
    },
    "owner": "ryan_novinc",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-live-activity",
      "expo-asset",
      "expo-notifications"
    ]
  }
}